# Application Settings
APP_NAME=TenderGuard
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tenderguard_db
# Optional full connection URL (e.g., postgresql://user:pass@localhost:5432/dbname or sqlite:///./tenderguard.db)
# DATABASE_URL=

# JWT Authentication Configuration
JWT_SECRET_KEY=tenderguard_jwt_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Seeding Configuration
ADMIN_NAME=Chief Procurement Auditor
ADMIN_EMAIL=admin@tenderguard.gov
ADMIN_PASSWORD=Admin@TenderGuard2026
ADMIN_ROLE=admin
